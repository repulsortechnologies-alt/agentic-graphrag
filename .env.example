# LLM (bring your own — free tier is fine). Leave unset to run fully offline (deterministic).
GEMINI_API_KEY=

# Graph backend: 'local' (offline, default) or 'tigergraph' (Savanna)
GRAPH_BACKEND=local

# TigerGraph Savanna (port 443 format). Generate secret in Admin Portal -> User Management.
TG_HOST=https://YOUR-DOMAIN.i.tgcloud.io:443
TG_GRAPH=olympics
TG_SECRET=
# TG_TOKEN=   # optional: pre-minted RESTPP bearer token (else minted from TG_SECRET)
